# Pre-commit (0.1: линт/формат только затронутых файлов; полный typecheck — в CI).
# Диспетчер .husky/_/h запускает этот файл через `sh -e`, поэтому при ошибке коммит блокируется.
#
# --max-arg-length: на Windows tinyexec оборачивает задачу в `cmd.exe /d /s /c "..."`,
# у которого жёсткий лимит строки — 8191 символ. lint-staged же чанкует файлы по
# НЕэкранированной длине (fits() не считает кавычки и ^-экранирование метасимволов),
# поэтому при 100+ staged-файлах с путями вида `(admin)` / `[id]` реальная строка
# превышала лимит: cmd.exe падал с «Произошла ошибка выполнения задачи.» и коммит
# блокировался без единого сообщения от eslint/prettier. 6000 даёт запас ~25% под
# экранирование; на не-Windows просто чанкует файлы чаще (без влияния на результат).
lint-staged --max-arg-length=6000

# Секрет-сканер (0.1): в CI обязателен (.github/workflows/ci.yml → job secrets),
# локально — при установленном gitleaks. v9+ команда называется `gitleaks git --staged`.
if command -v gitleaks >/dev/null 2>&1; then
	gitleaks protect --staged --redact
fi
