{
  "name": "mp-ui-kit",
  "version": "0.1.0",
  "description": "mp-ui-kit — дизайн-система и библиотека компонентов на базе Material UI",
  "type": "module",
  "main": "./dist/mp-ui-kit.cjs",
  "module": "./dist/es/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/es/index.js",
      "require": "./dist/mp-ui-kit.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "pnpm run build:lib && pnpm run build:types",
    "build:lib": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"for (const d of ['dist','storybook-static']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "prepack": "pnpm run typecheck && pnpm run build",
    "pack:dist": "pnpm pack",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "keywords": [
    "mui",
    "material-ui",
    "design-system",
    "ui-kit",
    "react",
    "components"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "@mui/x-date-pickers": "^9.0.0",
    "date-fns": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "date-fns": "^4.4.0",
    "playwright": "latest",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "latest"
  }
}
