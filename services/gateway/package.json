{
  "name": "@mp/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API-шлюз: JWT, роли, маршрутизация",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/main.js",
    "dev": "tsc -p tsconfig.json && node dist/app/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@mp/contracts": "workspace:*",
    "@mp/service-kit": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "jose": "5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mp/eslint-config-fsd": "workspace:*",
    "@mp/tsconfig": "workspace:*",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.5",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "supertest": "^7.1.3",
    "vitest": "^5.1.0"
  }
}
