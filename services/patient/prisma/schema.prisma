// Схема БД сервиса patient (db_patients) — владение patient-service (architecture.md §5).
// URL берётся из prisma.config.ts (env DATABASE_URL), а не отсюда (Prisma 7).
// Доменные модели добавляются в задачах эпиков — каркас содержит только
// служебные таблицы outbox/inbox (0.9).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Карточка пациента (1.4/эпик 4): связка «учётная запись Keycloak ↔ пациент».
/// Уникальные индексы по userId и email — идемпотентность саги регистрации (1.4 AC).
model Patient {
  id           String   @id @default(cuid())
  /// Keycloak `sub` — уникален: двойной submit не создаёт дубль.
  userId       String   @unique
  email        String   @unique
  firstName    String
  lastName     String
  middleName   String?
  birthDate    DateTime
  /// Ключ фото в MinIO (4.3): привязывает file-service, наружу не отдаётся.
  photoKey     String?
  registeredAt DateTime @default(now())

  @@index([lastName, firstName])
}

/// Outbox: событие пишется в той же транзакции, что и изменение (0.9).
model OutboxMessage {
  id            String    @id @default(cuid())
  /// Агрегат-источник (например, id сущности).
  aggregateId   String?
  routingKey    String
  payload       Json
  /// Время возникновения события (occurredAt конверта).
  occurredAt    DateTime?
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  publishedAt   DateTime?
  lastError     String?

  @@index([status, nextAttemptAt])
}

/// Inbox: idempotency-key потребителя (0.9) — повторная доставка не даёт эффекта дважды.
model InboxMessage {
  messageId   String    @id
  routingKey  String
  processedAt DateTime  @default(now())
}
