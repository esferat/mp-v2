# Зависимости и сборка
node_modules/
dist/
build/
.next/
out/
*.tsbuildinfo

# Вендорная статика Keycloakify: плагин Vite копирует её в public/ при каждой
# сборке темы (packages/keycloak-theme), сама тема собирается в build_keycloak
# (там лежит собственный .gitignore от keycloakify)
packages/keycloak-theme/public/

# Генерируемый Prisma Client (создаётся `pnpm gen`)
services/*/src/generated/

# Покрытие и артефакты тестов
coverage/
.nyc_output/

# Окружение и секреты
.env
.env.local
.env.*.local
!.env.example

# Локальные сертификаты TLS
infra/nginx/tls/*.pem
infra/nginx/tls/*.key

# Логи и редакторы
*.log
.idea/
.vscode/
.DS_Store

# Sonar
.scannerwork/
