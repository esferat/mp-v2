# Server certificate configuration: wildcard for all *.mp-kit.local hosts.
# v3_req  - extensions for the CSR request (no issuer yet -> no AKID).
# v3_cert - extensions applied when signing the certificate.
[req]
distinguished_name = dn
prompt = no
req_extensions = v3_req

[dn]
CN = *.mp-kit.local
O = mp-v2
C = RU

[v3_req]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

[v3_cert]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid,issuer
subjectAltName = @alt_names

# Wildcard does not cover the bare domain or localhost - listed explicitly.
[alt_names]
DNS.1 = *.mp-kit.local
DNS.2 = mp-kit.local
DNS.3 = localhost
IP.1 = 127.0.0.1
IP.2 = ::1
