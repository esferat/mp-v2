# ============================================================================
# mp-v2 вЂ” РµРґРёРЅС‹Р№ РїСЂРёРјРµСЂ РѕРєСЂСѓР¶РµРЅРёСЏ (0.3: В«Р»РѕРєР°Р»СЊРЅС‹Рµ РєСЂРµРґС‹ РµРґРёРЅС‹РµВ»).
# РЎРєРѕРїРёСЂСѓР№С‚Рµ: cp .env.example .env  вЂ” С„Р°Р№Р» .env РќР• РєРѕРјРјРёС‚РёС‚СЃСЏ.
# Р›РѕРєР°Р»СЊРЅС‹Рµ dev-РєСЂРµРґС‹ РЅРёР¶Рµ вЂ” С‚РѕР»СЊРєРѕ РґР»СЏ СЂР°Р·СЂР°Р±РѕС‚РєРё, РІ РїСЂРѕРґРµ Р±РµСЂСѓС‚СЃСЏ РёР· СЃРµРєСЂРµС‚РѕРІ.
# ============================================================================

# --- РћР±С‰РµРµ ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (РµРґРёРЅС‹Р№ РёРЅСЃС‚Р°РЅСЃ, Р‘Р” Рё РїРѕР»СЊР·РѕРІР°С‚РµР»Рё вЂ” РЅР° СЃРµСЂРІРёСЃ) ---
POSTGRES_USER=mp
POSTGRES_PASSWORD=mp
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# РџР°СЂРѕР»Рё РїРѕР»СЊР·РѕРІР°С‚РµР»РµР№ СЃРµСЂРІРёСЃРѕРІ (РµРґРёРЅС‹Р№ РїСЂРµС„РёРєСЃ *_pw вЂ” РЅРµ СЂР°Р·РІРѕРґРёРј РїР°СЂРѕР»Рё)
SVC_IDENTITY_PASSWORD=svc_identity_pw
SVC_CATALOG_PASSWORD=svc_catalog_pw
SVC_PATIENTS_PASSWORD=svc_patients_pw
SVC_FILES_PASSWORD=svc_files_pw
SVC_SCHEDULE_PASSWORD=svc_schedule_pw
SVC_REPORT_PASSWORD=svc_report_pw
SVC_NOTIFICATION_PASSWORD=svc_notification_pw

# URL РґР»СЏ Р»РѕРєР°Р»СЊРЅРѕР№ СЂР°Р·СЂР°Р±РѕС‚РєРё (pnpm dev РЅР° С…РѕСЃС‚Рµ). Р’ РєРѕРЅС‚РµР№РЅРµСЂР°С… host = postgres.
DATABASE_URL_IDENTITY=postgresql://svc_identity:svc_identity_pw@localhost:5432/db_identity?schema=public
DATABASE_URL_CATALOG=postgresql://svc_catalog:svc_catalog_pw@localhost:5432/db_catalog?schema=public
DATABASE_URL_PATIENTS=postgresql://svc_patients:svc_patients_pw@localhost:5432/db_patients?schema=public
DATABASE_URL_FILES=postgresql://svc_files:svc_files_pw@localhost:5432/db_files?schema=public
DATABASE_URL_SCHEDULE=postgresql://svc_schedule:svc_schedule_pw@localhost:5432/db_schedule?schema=public
DATABASE_URL_REPORT=postgresql://svc_report:svc_report_pw@localhost:5432/db_report?schema=public
DATABASE_URL_NOTIFICATION=postgresql://svc_notification:svc_notification_pw@localhost:5432/db_notification?schema=public

# --- Keycloak ---
# Keycloak: публичный origin (браузерный) — issuer в токенах = KEYCLOAK_HOSTNAME/realms/...
# HTTPS-терминал — nginx: auth.mp-kit.local → keycloak:8080 (сертификаты: infra/nginx/tls);
# в hosts хоста нужна строка 127.0.0.1 auth.mp-kit.local.
# Серверные вызовы web (token/userinfo) идут на keycloak:8080 внутри compose —
# endpoints разделены вручную в shared/config/auth.ts (см. AUTH_KEYCLOAK_INTERNAL_URL).
KEYCLOAK_HOSTNAME=https://auth.mp-kit.local
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=medical-portal
# Р’РЅСѓС‚СЂРµРЅРЅРёР№ URL (РґР»СЏ РєРѕРЅС‚РµР№РЅРµСЂРѕРІ: jwks, Admin API) вЂ” РІ compose РїРµСЂРµРѕРїСЂРµРґРµР»СЏРµС‚СЃСЏ РЅР° http://keycloak:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8180
# РЎРµСЂРІРёСЃРЅС‹Рµ РєР»РёРµРЅС‚С‹ (confidential, dev-СЃРµРєСЂРµС‚С‹ вЂ” С‚РѕР»СЊРєРѕ РґР»СЏ Р»РѕРєР°Р»Рё)
KEYCLOAK_SVC_GW_CLIENT_ID=svc-gateway
KEYCLOAK_SVC_GW_SECRET=dev-gateway-secret
KEYCLOAK_SVC_IDENTITY_CLIENT_ID=svc-identity
KEYCLOAK_SVC_IDENTITY_SECRET=dev-identity-secret
KEYCLOAK_SVC_BACKEND_CLIENT_ID=svc-backend
KEYCLOAK_SVC_BACKEND_SECRET=dev-backend-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# РўРµСЃС‚РѕРІС‹Рµ РїРѕР»СЊР·РѕРІР°С‚РµР»Рё (seed СЂРµР°Р»РјР°, 0.4)
KEYCLOAK_SEED_ADMIN_EMAIL=admin@test.mp
KEYCLOAK_SEED_PATIENT_EMAIL=patient@test.mp
KEYCLOAK_SEED_DOCTOR_EMAIL=doctor@test.mp
KEYCLOAK_SEED_PASSWORD=Password123!

# --- MinIO ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
# Р’РЅСѓС‚СЂРµРЅРЅРёР№ Р°РґСЂРµСЃ MinIO (РґР»СЏ СЃРµСЂРІРёСЃРѕРІ РІ РєРѕРЅС‚РµР№РЅРµСЂР°С… РїРµСЂРµРєСЂС‹РІР°РµС‚СЃСЏ http://minio:9000)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# presigned TTL (NFR: 5 РјРёРЅСѓС‚)
PRESIGNED_TTL_SECONDS=300

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Topic exchange СЃРѕР±С‹С‚РёР№ (architecture.md В§6.3)
RABBITMQ_EXCHANGE=medical.events
RABBITMQ_DLX_EXCHANGE=medical.dlx

# --- РџСЂРёР»РѕР¶РµРЅРёСЏ (dev РЅР° С…РѕСЃС‚Рµ) ---
WEB_PORT=3000
GATEWAY_PORT=4000
GATEWAY_URL=http://localhost:4000
# Р’РЅСѓС‚СЂРµРЅРЅРёР№ Р°РґСЂРµСЃ gateway РІ compose
GATEWAY_INTERNAL_URL=http://gateway:4000

# --- Web: Auth.js / OIDC (Р·Р°РґР°С‡Р° 1.1) ---
# AUTH_SECRET вЂ” СЃРµСЃСЃРёРѕРЅРЅР°СЏ РїРѕРґРїРёСЃСЊ (РІ РїСЂРѕРґРµ вЂ” РёР· СЃРµРєСЂРµС‚РѕРІ; Р·РґРµСЃСЊ dev-Р·РЅР°С‡РµРЅРёРµ)
AUTH_SECRET=dev-only-secret-change-me
# NB: AUTH_URL РЅРµ Р·Р°РґР°С‘Рј вЂ” Auth.js (trustHost) Р±РµСЂС‘С‚ origin РёР· Р·Р°РїСЂРѕСЃР°,
# РёРЅР°С‡Рµ redirect_uri РІСЃРµРіРґР° localhost Рё РІС…РѕРґ С‡РµСЂРµР· *.mp-kit.local СЃР»РѕРјР°РµС‚СЃСЏ.
# РџСѓР±Р»РёС‡РЅС‹Р№ РєР»РёРµРЅС‚ Keycloak (PKCE, Р±РµР· СЃРµРєСЂРµС‚Р°)
AUTH_KEYCLOAK_ID=next-web
AUTH_KEYCLOAK_SECRET=
# РђСѓРґРёРѕСЂРёРё, РєРѕС‚РѕСЂС‹Рµ РїСЂРёРЅРёРјР°РµС‚ gateway (client_id С‡РµСЂРµР· Р·Р°РїСЏС‚СѓСЋ)
AUTH_AUDIENCE=next-web,svc-e2e,svc-gateway,svc-backend,svc-identity,svc-file
# Service account file-service (РІС‹Р·РѕРІС‹ patient/catalog, 3.4/4.4)
KEYCLOAK_SVC_FILE_CLIENT_ID=svc-file
KEYCLOAK_SVC_FILE_SECRET=dev-file-secret

# --- nginx ---
NGINX_PORT=8080
# Р”РѕРјРµРЅС‹ *.mp-kit.local (hosts в†’ 127.0.0.1) С…РѕРґСЏС‚ РЅР° СЃС‚Р°РЅРґР°СЂС‚РЅС‹Р№ РїРѕСЂС‚
NGINX_HTTP_PORT=80
# HTTPS для *.mp-kit.local (сертификаты — infra/nginx/tls, см. README.md)
NGINX_HTTPS_PORT=443

# --- Р›РѕРіРё: pino в†’ Filebeat в†’ Elasticsearch в†’ Kibana (0.10) ---
ELASTIC_PORT=9200
KIBANA_PORT=5601
PROMETHEUS_PORT=9090
# ILM-СЂРµС‚РµРЅС€РЅ (РґРЅРё): hot в†’ warm в†’ delete
LOG_ILM_HOT_DAYS=7
LOG_ILM_WARM_DAYS=30
LOG_INDEX_PREFIX=mp-logs

# --- РџРѕС‡С‚Р° (dev-SMTP) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@test.mp
# env-whitelist тестовых адресов (6.2): письма им не шлются (через запятую)
NOTIFY_SKIP_RECIPIENTS=
