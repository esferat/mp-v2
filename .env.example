# ============================================================================
# mp-v2 — единый пример окружения (0.3: «локальные креды единые»).
# Скопируйте: cp .env.example .env  — файл .env НЕ коммитится.
# Локальные dev-креды ниже — только для разработки, в проде берутся из секретов.
# ============================================================================

# --- Общее ---
NODE_ENV=development
LOG_LEVEL=info

# --- PostgreSQL (единый инстанс, БД и пользователи — на сервис) ---
POSTGRES_USER=mp
POSTGRES_PASSWORD=mp
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Пароли пользователей сервисов (единый префикс *_pw — не разводим пароли)
SVC_IDENTITY_PASSWORD=svc_identity_pw
SVC_CATALOG_PASSWORD=svc_catalog_pw
SVC_PATIENTS_PASSWORD=svc_patients_pw
SVC_FILES_PASSWORD=svc_files_pw
SVC_SCHEDULE_PASSWORD=svc_schedule_pw
SVC_REPORT_PASSWORD=svc_report_pw

# URL для локальной разработки (pnpm dev на хосте). В контейнерах host = postgres.
DATABASE_URL_IDENTITY=postgresql://svc_identity:svc_identity_pw@localhost:5432/db_identity?schema=public
DATABASE_URL_CATALOG=postgresql://svc_catalog:svc_catalog_pw@localhost:5432/db_catalog?schema=public
DATABASE_URL_PATIENTS=postgresql://svc_patients:svc_patients_pw@localhost:5432/db_patients?schema=public
DATABASE_URL_FILES=postgresql://svc_files:svc_files_pw@localhost:5432/db_files?schema=public
DATABASE_URL_SCHEDULE=postgresql://svc_schedule:svc_schedule_pw@localhost:5432/db_schedule?schema=public
DATABASE_URL_REPORT=postgresql://svc_report:svc_report_pw@localhost:5432/db_report?schema=public

# --- Keycloak ---
# Порт публикуется на хосте:8180. issuer в токенах = KEYCLOAK_HOSTNAME/realms/...
# NB: для браузера нужен localhost:8180 (host.docker.internal с хоста недоступен);
# серверные вызовы web (token/userinfo) идут на keycloak:8080 внутри compose —
# endpoints разделены вручную в shared/config/auth.ts (см. AUTH_KEYCLOAK_INTERNAL_URL).
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=medical-portal
# Внутренний URL (для контейнеров: jwks, Admin API) — в compose переопределяется на http://keycloak:8080
KEYCLOAK_INTERNAL_URL=http://localhost:8180
# Сервисные клиенты (confidential, dev-секреты — только для локали)
KEYCLOAK_SVC_GW_CLIENT_ID=svc-gateway
KEYCLOAK_SVC_GW_SECRET=dev-gateway-secret
KEYCLOAK_SVC_IDENTITY_CLIENT_ID=svc-identity
KEYCLOAK_SVC_IDENTITY_SECRET=dev-identity-secret
KEYCLOAK_SVC_BACKEND_CLIENT_ID=svc-backend
KEYCLOAK_SVC_BACKEND_SECRET=dev-backend-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Тестовые пользователи (seed реалма, 0.4)
KEYCLOAK_SEED_ADMIN_EMAIL=admin@test.mp
KEYCLOAK_SEED_PATIENT_EMAIL=patient@test.mp
KEYCLOAK_SEED_DOCTOR_EMAIL=doctor@test.mp
KEYCLOAK_SEED_PASSWORD=Password123!

# --- MinIO ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
# Внутренний адрес MinIO (для сервисов в контейнерах перекрывается http://minio:9000)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# presigned TTL (NFR: 5 минут)
PRESIGNED_TTL_SECONDS=300

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Topic exchange событий (architecture.md §6.3)
RABBITMQ_EXCHANGE=medical.events
RABBITMQ_DLX_EXCHANGE=medical.dlx

# --- Приложения (dev на хосте) ---
WEB_PORT=3000
GATEWAY_PORT=4000
GATEWAY_URL=http://localhost:4000
# Внутренний адрес gateway в compose
GATEWAY_INTERNAL_URL=http://gateway:4000

# --- Web: Auth.js / OIDC (задача 1.1) ---
# AUTH_SECRET — сессионная подпись (в проде — из секретов; здесь dev-значение)
AUTH_SECRET=dev-only-secret-change-me
# NB: AUTH_URL не задаём — Auth.js (trustHost) берёт origin из запроса,
# иначе redirect_uri всегда localhost и вход через *.mp-kit.local сломается.
# Публичный клиент Keycloak (PKCE, без секрета)
AUTH_KEYCLOAK_ID=next-web
AUTH_KEYCLOAK_SECRET=
# Аудиории, которые принимает gateway (client_id через запятую)
AUTH_AUDIENCE=next-web,svc-e2e,svc-gateway,svc-backend,svc-identity,svc-file
# Service account file-service (вызовы patient/catalog, 3.4/4.4)
KEYCLOAK_SVC_FILE_CLIENT_ID=svc-file
KEYCLOAK_SVC_FILE_SECRET=dev-file-secret

# --- nginx ---
NGINX_PORT=8080
# Домены *.mp-kit.local (hosts → 127.0.0.1) ходят на стандартный порт
NGINX_HTTP_PORT=80

# --- Логи: pino → Filebeat → Elasticsearch → Kibana (0.10) ---
ELASTIC_PORT=9200
KIBANA_PORT=5601
# ILM-ретеншн (дни): hot → warm → delete
LOG_ILM_HOT_DAYS=7
LOG_ILM_WARM_DAYS=30
LOG_INDEX_PREFIX=mp-logs

# --- Почта (dev-SMTP) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@test.mp
